# Copy this file to .env and fill it in. .env is never committed to git.
# On the server, create .env next to this file (in the repository folder).

# --- App ------------------------------------------------------------------
# local on your computer, production on the server
APP_ENV=production
# true shows error details in the browser. Keep false on the live site.
APP_DEBUG=false
# The address people open, without a trailing slash
APP_URL=https://nexus.pribadidepok.sch.id
APP_TIMEZONE=Asia/Jakarta
SESSION_LIFETIME_DAYS=14

# --- Signage --------------------------------------------------------------
# Maximum size of one media upload in MB (up to 250). Also set PHP upload_max_filesize and
# post_max_size in cPanel. Files use your hosting disk and bandwidth allowance.
SIGNAGE_MAX_UPLOAD_MB=250
# Speed limit per video download to TVs/previews, in MB/s (0 = no limit).
# Keeps the hosting account's disk I/O limit free for the other sites.
SIGNAGE_STREAM_MBPS=2
# TV control: a long random secret shared with the helper PC (bin/tv-agent.ps1),
# which runs Open Nexus / Restart / Status / Screenshot on TVs over ADB.
# Leave empty to hide TV control. Generate one with: php -r "echo bin2hex(random_bytes(32));"
SIGNAGE_TV_AGENT_TOKEN=

# --- Sign-in ------------------------------------------------------------------
# The one shared password everyone uses to sign in (with their own name).
# Use a long one: at least 12 characters. Changing it signs everyone out.
APP_PASSWORD=
# Wrong passwords allowed per device (IP address) before it must wait.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --- Database (cPanel > MySQL Databases) ------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_nexus
DB_USERNAME=cpaneluser_nexus
DB_PASSWORD=

# --- Google Admin (optional; see docs/google-admin.md) ----------------------
# Absolute path OUTSIDE public/; never commit the service account JSON key.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_ADMIN_EMAIL=
GOOGLE_CUSTOMER_ID=
GOOGLE_TELEMETRY_ENABLED=true
# A password_hash() result for a separate OU management password.
# Empty keeps remote OU changes disabled. This is not APP_PASSWORD.
GOOGLE_OU_PASSWORD_HASH=
