# Nexus: the subdomain's document root points here (public/).

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Real files (CSS, JS, fonts, icons) are served directly; everything else
  # goes to the front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType font/woff2 .woff2

# Static assets carry ?v=<file time> in their URLs, so they can be cached for a
# long time: a changed file gets a new URL.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
