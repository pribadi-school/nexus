# Nexus: the subdomain's document root points here (public/).

Options -Indexes
DirectoryIndex index.php

<Files ".user.ini">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Real files (CSS, JS, fonts, icons) are served directly; everything else
  # goes to the front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>

# BEGIN NEXUS UPLOADS
# LiteSpeed / CloudLinux LSAPI read these instead of CGI/FastCGI .user.ini.
<IfModule LiteSpeed>
  php_value upload_max_filesize 500M
  php_value post_max_size 512M
  php_value max_input_time 1800
  php_value max_execution_time 600
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
  php_value upload_max_filesize 500M
  php_value post_max_size 512M
  php_value max_input_time 1800
  php_value max_execution_time 600
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>
# END NEXUS UPLOADS

AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType font/woff2 .woff2

# Static assets carry ?v=<file time> in their URLs, so they can be cached for a
# long time: a changed file gets a new URL.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
