# Fallback for hosts where the subdomain's document root cannot point at
# public/ and points at this repository folder instead: send every request
# into public/, so app code, .env and the database files are never served.
# (When the document root IS public/, this file is never read.)

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
